<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 1.0.0 */
/** @var Template $block */
/** @var Escaper $escaper */
?>
<script>
    LokiComponentValidator.validators.indianGstNumber = function (component) {
        const gstNumber = String(component.value ?? '').replace(/\s+/g, '').toUpperCase();
        if (gstNumber === '') {
            return true;
        }

        const addError = function (text) {
            component.messages.push({type: 'error', text: text});
            return false;
        };

        if (/^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/.test(gstNumber) === false) {
            return addError('<?= $escaper->escapeJs(__('Invalid GST Number format. Expected format: 22AAAAA0000A1ZC')) ?>');
        }

        const stateCode = parseInt(gstNumber.substring(0, 2), 10);
        if ((stateCode < 1 || stateCode > 38) && [96, 97, 99].includes(stateCode) === false) {
            return addError('<?= $escaper->escapeJs(__('Invalid GST Number: The first two digits are not a valid GST state code')) ?>');
        }

        const characters = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        let sum = 0;
        for (let position = 0; position < 14; position++) {
            const product = characters.indexOf(gstNumber[position]) * ((position % 2) + 1);
            sum += Math.floor(product / 36) + (product % 36);
        }

        if (characters[(36 - (sum % 36)) % 36] !== gstNumber[14]) {
            return addError('<?= $escaper->escapeJs(__('Invalid GST Number: The check character does not match')) ?>');
        }

        return true;
    }
</script>
