<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 0.1.0 */
/** @var Template $block */
/** @var Escaper $escaper */
?>
<script>
    LokiComponentValidator.validators.indianGstNumber = function (component) {
        if (!component.value) {
            return true;
        }

        const pattern = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/;

        if (pattern.test(component.value) === false) {
            component.messages.push({
                type: 'error',
                text: '<?= $escaper->escapeHtml(__('Invalid GST Number format. Expected format: 22AAAAA0000A1Z5')) ?>'
            });
            return false;
        }

        return true;
    }
</script>
